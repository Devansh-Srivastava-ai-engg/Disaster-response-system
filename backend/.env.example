# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string from your hosting provider.
# Get a free database from one of these:
#   Neon:     https://neon.tech           (fully free, serverless Postgres)
#   Supabase: https://supabase.com        (free tier)
#   Railway:  https://railway.app         (free trial credits)
#
# Example formats:
#   postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require      (Neon / Supabase)
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE               (local)
DATABASE_URL=postgresql://postgres:password@localhost:5432/disaster_response

# ── Optional ─────────────────────────────────────────────────────────────────
# Port the backend will listen on (hosting platforms set this automatically)
PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
# Leave empty to allow all (fine for development).
# Example: https://your-citizen-app.vercel.app,https://your-rescuer-app.vercel.app
ALLOWED_ORIGINS=
